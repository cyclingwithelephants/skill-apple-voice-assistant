<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cyclingwithelephants.apple-voice-assistant</string>

    <key>ProgramArguments</key>
    <array>
        <string>__WATCHER_SCRIPT__</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>__RECORDINGS_DIR__</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__STATE_DIR__/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__STATE_DIR__/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/run/current-system/sw/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HERMES_HOME</key>
        <string>__HOME__/.hermes</string>
        <key>APPLE_VOICE_ASSISTANT_PYTHON</key>
        <string>__HOME__/.hermes/hermes-agent/venv/bin/python</string>
        <key>APPLE_VOICE_ASSISTANT_WHISPER_API_BASE</key>
        <string>http://127.0.0.1:9099</string>
    </dict>
</dict>
</plist>
